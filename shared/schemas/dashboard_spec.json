{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://udc.enterprise/schemas/dashboard_spec.json",
  "title": "DashboardSpec",
  "description": "Schema for dashboard definitions generated by UDC",
  "type": "object",
  "required": ["title", "data_sources", "visuals"],
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "description": {
      "type": "string"
    },
    "original_request": {
      "type": "string",
      "description": "The natural language request that generated this dashboard"
    },
    "target": {
      "type": "string",
      "enum": ["powerbi", "html"],
      "default": "powerbi"
    },
    "data_sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/data_source"
      }
    },
    "measures": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/measure"
      }
    },
    "visuals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/visual"
      }
    },
    "filters": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/filter"
      }
    },
    "layout": {
      "type": "object",
      "properties": {
        "columns": { "type": "integer", "minimum": 1, "maximum": 12 },
        "rows": { "type": "integer", "minimum": 1 },
        "theme": { "type": "string", "enum": ["light", "dark", "corporate"] }
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "created_by": {
      "type": "string"
    }
  },
  "$defs": {
    "data_source": {
      "type": "object",
      "required": ["asset_id", "alias"],
      "properties": {
        "asset_id": { "type": "string" },
        "alias": { "type": "string" },
        "columns": {
          "type": "array",
          "items": { "type": "string" }
        },
        "filters": {
          "type": "array",
          "items": { "$ref": "#/$defs/filter" }
        }
      }
    },
    "measure": {
      "type": "object",
      "required": ["name", "expression"],
      "properties": {
        "name": { "type": "string" },
        "expression": {
          "type": "string",
          "description": "DAX or SQL expression"
        },
        "format": { "type": "string", "description": "Number format: #,##0.00, 0%, etc." },
        "description": { "type": "string" }
      }
    },
    "visual": {
      "type": "object",
      "required": ["visual_type", "title"],
      "properties": {
        "visual_type": {
          "type": "string",
          "enum": ["bar", "line", "pie", "card", "table", "scatter", "map", "kpi", "combo"]
        },
        "title": { "type": "string" },
        "x_axis": { "type": "string", "description": "Column or measure name" },
        "y_axis": {
          "oneOf": [
            { "type": "string" },
            { "type": "array", "items": { "type": "string" } }
          ],
          "description": "Column or measure name(s)"
        },
        "legend": { "type": "string" },
        "values": {
          "type": "array",
          "items": { "type": "string" },
          "description": "For card/KPI visuals"
        },
        "sort_by": { "type": "string" },
        "sort_order": { "type": "string", "enum": ["asc", "desc"] },
        "grid_position": {
          "type": "object",
          "properties": {
            "row": { "type": "integer" },
            "col": { "type": "integer" },
            "width": { "type": "integer" },
            "height": { "type": "integer" }
          }
        }
      }
    },
    "filter": {
      "type": "object",
      "required": ["column", "filter_type"],
      "properties": {
        "column": { "type": "string" },
        "filter_type": {
          "type": "string",
          "enum": ["dropdown", "date_range", "range", "text", "multi_select"]
        },
        "default_value": {},
        "label": { "type": "string" }
      }
    }
  }
}
